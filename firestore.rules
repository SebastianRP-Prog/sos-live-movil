rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAgentLocationUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'location',
        'mapa',
        'ubicacionExacta',
        'ultimaUbicacionTexto',
        'ultimaConexionAt',
        'updatedAt',
        'companyId',
        'companyUid'
      ]);
    }

    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isOwner(userId);
    }

    match /Agentes/{agentId} {
      allow read: if true;
      allow update: if isAgentLocationUpdate();
      allow create, delete: if false;
    }

    match /dashboard_agents/{agentId} {
      allow read: if true;
      allow update: if isAgentLocationUpdate();
      allow create, delete: if false;
    }

    match /companies/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    match /empresas/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    match /Empresas/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    match /dashboard_companies/{companyId} {
      allow read: if true;
      allow write: if false;
    }

    match /company_payments/{paymentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.simulation == true;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /chats/{chatId} {
      allow read, create, update: if true;

      match /messages/{messageId} {
        allow read, create, update: if true;
      }
    }

    match /notices/{noticeId} {
      allow read, update: if true;
      allow create: if signedIn();
    }

    match /dashboard_alerts/{alertId} {
      allow read, update: if true;
      allow create: if true;
    }

    match /sos_alerts/{alertId} {
      allow read, update: if true;
      allow create: if true;
    }

    match /alertas_activas/{alertId} {
      allow read, update: if true;
      allow create: if true;
    }

    match /service_ratings/{ratingId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if true;
      allow update, delete: if false;
    }

    match /danger_zones/{zoneId} {
      allow read: if true;
    }
  }
}
